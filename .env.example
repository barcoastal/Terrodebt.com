# TerraDebt environment variables
# Copy this file to `.env` and fill in real values for local dev.
# In production (Railway), set these as environment variables in the service dashboard.

# Postgres connection string (Railway provides this automatically when you attach a Postgres plugin)
DATABASE_URL="postgresql://user:password@localhost:5432/terradebt?schema=public"
SLACK_LEADS_WEBHOOK_URL=
COASTAL_CRM_WEBHOOK_URL=
COASTAL_CRM_WEBHOOK_SECRET=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
